+//! Application-owned records for PTYs that this terminal actually starts.
+//! The native utmpx layout is shared with the OHOS coreutils file reader.
+
+use std::fs::{File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::{Path, PathBuf};
+
+pub(super) struct SessionGuard {
+    path: PathBuf,
+}
+
+fn put_string(field: &mut [libc::c_char], value: &str) -> io::Result<()> {
+    if value.len() >= field.len() || value.as_bytes().contains(&0) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "PTY record field is too long",
+        ));
+    }
+    for (dest, byte) in field.iter_mut().zip(value.bytes()) {
+        *dest = byte as _;
+    }
+    Ok(())
+}
+
+fn write_record(
+    file: &mut File,
+    kind: i16,
+    pid: i32,
+    tty: &str,
+    user: &str,
+    seconds: i64,
+) -> io::Result<()> {
+    let mut storage = std::mem::MaybeUninit::<libc::utmpx>::zeroed();
+    // SAFETY: initialize the record's bytes, including padding, and write fields
+    // in place. No structure move may discard padding before serialization.
+    unsafe {
+        let record = storage.as_mut_ptr();
+        (*record).ut_type = kind;
+        (*record).ut_pid = pid;
+        (*record).ut_tv.tv_sec = seconds.try_into().map_err(|_| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "PTY timestamp exceeds native utmpx range",
+            )
+        })?;
+        put_string(&mut (*record).ut_line, tty)?;
+        put_string(&mut (*record).ut_user, user)?;
+        file.write_all(std::slice::from_raw_parts(
+            record.cast::<u8>(),
+            size_of::<libc::utmpx>(),
+        ))
+    }
+}
+
+impl SessionGuard {
+    pub(super) fn register(
+        directory: &Path,
+        pid: u32,
+        tty: &str,
+        user: &str,
+        login: i64,
+        boot: i64,
+    ) -> io::Result<Self> {
+        std::fs::create_dir_all(directory)?;
+        let path = directory.join(format!("{pid}.utmpx"));
+        let temporary = directory.join(format!(".{pid}.tmp"));
+        let result = (|| {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .custom_flags(libc::O_NOFOLLOW)
+                .open(&temporary)?;
+            write_record(&mut file, libc::BOOT_TIME, 0, "", "", boot)?;
+            write_record(
+                &mut file,
+                libc::USER_PROCESS,
+                pid.try_into().map_err(|_| {
+                    io::Error::new(io::ErrorKind::InvalidInput, "PTY PID exceeds native range")
+                })?,
+                tty.trim_start_matches("/dev/"),
+                user,
+                login,
+            )?;
+            file.sync_all()?;
+            std::fs::rename(&temporary, &path)?;
+            Ok(Self { path })
+        })();
+        if result.is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+        result
+    }
+}
+
+impl Drop for SessionGuard {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    #[test]
+    fn records_real_pid_with_private_mode_and_removes_it_on_close() {
+        let directory =
+            std::env::temp_dir().join(format!("arkit-session-test-{}", std::process::id()));
+        std::fs::create_dir_all(&directory).unwrap();
+        let guard = SessionGuard::register(
+            &directory,
+            std::process::id(),
+            "/dev/pts/7",
+            "1234",
+            1700000100,
+            1700000000,
+        )
+        .unwrap();
+        assert_eq!(
+            std::fs::metadata(&guard.path).unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+        let bytes = std::fs::read(&guard.path).unwrap();
+        assert_eq!(bytes.len(), 2 * size_of::<libc::utmpx>());
+        // SAFETY: read the complete integer-and-array record without alignment requirements.
+        let record = unsafe {
+            std::ptr::read_unaligned(
+                bytes[size_of::<libc::utmpx>()..]
+                    .as_ptr()
+                    .cast::<libc::utmpx>(),
+            )
+        };
+        assert_eq!(record.ut_pid, std::process::id() as i32);
+        assert_eq!(record.ut_type, libc::USER_PROCESS);
+        assert_eq!(record.ut_tv.tv_sec, 1700000100);
+        let path = guard.path.clone();
+        drop(guard);
+        assert!(!path.exists());
+        std::fs::remove_dir(&directory).unwrap();
+    }
+}
